# SMS Alert
SMS_ALERT_API_KEY=
SMS_ALERT_SENDER_ID=RDFCBE
SMS_ALERT_USERNAME=
SMS_ALERT_ROUTE=
OTP_SMS_STRICT=false

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
