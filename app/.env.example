# AI product image generation (never commit real keys)
# Use OpenAI platform API key from https://platform.openai.com/api-keys (not ChatGPT Go login)
AI_IMAGE_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_SIZE=1024x1024
OPENAI_IMAGE_QUALITY=medium
AI_IMAGE_TOOL_TOKEN=

# Optional Gemini fallback
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_IMAGE_TOOL_TOKEN=
